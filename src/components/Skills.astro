---

<section class="max-w-[45rem] mx-auto my-6 bg-white dark:bg-zinc-900 rounded-2xl px-8 py-10 transition-colors duration-500">
  <div class="flex items-center gap-2 mb-4">
    <svg width="42" height="42" fill="#FF3B3F" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path fill="none" d="M0 0h24v24H0z" />
      <path d="M5.33 3.271a3.5 3.5 0 0 1 4.254 4.963l10.709 10.71-1.414 1.414-10.71-10.71a3.502 3.502 0 0 1-4.962-4.255L5.444 7.63a1.5 1.5 0 1 0 2.121-2.121L5.329 3.27zm10.367 1.884l3.182-1.768 1.414 1.414-1.768 3.182-1.768.354-2.12 2.121-1.415-1.414 2.121-2.121.354-1.768zm-6.718 8.132l1.414 1.414-5.303 5.303a1 1 0 0 1-1.492-1.327l.078-.087 5.303-5.303z" />
    </svg>
    <h2 class="text-2xl font-semibold text-[#4B5463] dark:text-white">Skills</h2>
  </div>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Here's what I've used so far:</p>
  <div class="flex flex-row flex-wrap gap-3 max-sm:justify-center">
    {skills.map((skill) => (
      <div
        class="flex flex-row items-center gap-2 px-4 py-1.5 rounded shadow-sm text-sm font-medium"
        style={`background-color: ${skill.bg}; color: ${skill.text};`}
      >
        <span set:html={skill.icon} />
        <span>{skill.name}</span>
      </div>
    ))}
  </div>
</section>
